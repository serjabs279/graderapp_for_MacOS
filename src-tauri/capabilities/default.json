{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-app-read",
    "fs:allow-app-write",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-download-read",
    "fs:allow-download-write",
    "fs:allow-document-read",
    "fs:allow-document-write",
    "fs:allow-public-read",
    "fs:allow-public-write",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "content://com.android.externalstorage.documents/*" },
        { "url": "content://com.android.providers.downloads.documents/*" },
        { "url": "content://com.android.providers.media.documents/*" },
        { "url": "content://com.google.android.apps.docs.storage/*" }
      ]
    }
  ]
}
